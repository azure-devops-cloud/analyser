# Required only for live Telegram delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Core runtime.
DEBUG=false
TIMEZONE=Asia/Kolkata

# Free-first model abstraction.
MODEL_PROVIDER=ollama
MODEL_NAME=qwen3:4b
MODEL_TEMPERATURE=0.0
MODEL_MAX_TOKENS=2048
MODEL_TIMEOUT=30

# Autonomous recovery controls.
AGENT_MAX_RETRIES=1
AGENT_BACKOFF_SECONDS=0.25
AGENT_STOP_ON_CRITICAL_FAILURE=false

# Optional future OpenTelemetry integration.
TELEMETRY_ENABLED=false
